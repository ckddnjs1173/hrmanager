# ===== 노무AI 환경변수 =====
# 이 파일을 .env 로 복사해 값을 채우세요. (배포 시에는 호스트의 환경변수 설정창에 입력)

# ── AI provider (하나 이상 설정. 여러 개면 primary 실패 시 자동 폴백) ──
# 우선순위: AI_PROVIDER 지정 시 그것 → 기본 precedence: anthropic > gemini > groq.
# 모두 비우면 AI 상담은 '데모 모드'(목업), 나머지 기능은 정상 동작.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
AI_PROVIDER=

ADMIN_TOKEN=change-this-to-a-strong-secret
SESSION_SECRET=

# ===== Storage =====
STORAGE_DRIVER=sqlite
DB_PATH=
DATABASE_URL=
PG_POOL_MAX=5
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000

# Business Case 문서 원본 암호화 비밀값. 최소 32자 이상의 충분히 랜덤한 secret.
# 기존 암호화 문서 복호화에 필요하므로 키 회전 기능 도입 전 임의 변경 금지.
DOCUMENT_STORAGE_SECRET=

REQUIRE_PERSISTENT_DB=0
PERSISTENT_STORAGE=0

# ===== Business / Pro SaaS runtime =====
# 기본 OFF. 1로 켜려면 STORAGE_DRIVER=postgres + DATABASE_URL + SAAS_SESSION_SECRET가 모두 필요합니다.
SAAS_ENABLED=0
SAAS_SESSION_SECRET=
SAAS_SESSION_TTL_DAYS=30
SAAS_AUTH_CHALLENGE_TTL_MINUTES=15
SAAS_INVITATION_TTL_DAYS=7
SAAS_SESSION_COOKIE=insaya_saas_session
COMPLIANCE_NOTIFICATION_SWEEP_INTERVAL_MS=3600000

# 테스트/로컬에서만 raw magic-link/초대 토큰을 API 응답에 포함합니다.
# NODE_ENV=production에서는 1을 허용하지 않습니다.
SAAS_AUTH_TOKEN_ECHO=0

# ===== Production SaaS email delivery (optional) =====
# 모두 설정된 경우 Business magic-link 및 외부 전문가 초대를 이메일로 발송합니다.
# provider 미설정 시 개발환경은 기존 debug-token 흐름, production은 fail-closed를 유지합니다.
SAAS_EMAIL_PROVIDER=
RESEND_API_KEY=
# 예: 인사야 <no-reply@your-verified-domain.com>
SAAS_EMAIL_FROM=

# Case 개인정보 최소화 정책
CASE_TOKEN_TTL_DAYS=7
CASE_RETENTION_DAYS=30
CASE_ARCHIVED_RETENTION_DAYS=7

# 배포 도메인. 이메일 로그인/초대 링크 생성에도 사용하므로 production에서는 정확한 HTTPS origin 설정 권장.
SITE_URL=
PORT=3000
