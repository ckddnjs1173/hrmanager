# ===== 노무AI 환경변수 =====
# 이 파일을 .env 로 복사해 값을 채우세요. (배포 시에는 호스트의 환경변수 설정창에 입력)

# ── AI provider (하나 이상 설정. 여러 개면 primary 실패 시 자동 폴백) ──
# 우선순위: AI_PROVIDER 지정 시 그것 → 기본 precedence: anthropic > gemini > groq.
# 모두 비우면 AI 상담은 '데모 모드'(목업), 나머지 기능은 정상 동작.

# (선택) Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# (무료·권장) Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# (무료·폴백) Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# provider 강제 지정(선택): anthropic | gemini | groq
AI_PROVIDER=

# 운영자 대시보드(/admin) 로그인 토큰. 배포 시 반드시 강력한 값으로 변경하세요.
ADMIN_TOKEN=change-this-to-a-strong-secret

# 기존 Admin/Partner 세션 쿠키 서명 키.
SESSION_SECRET=

# ===== Storage =====
# 기본값은 SQLite. 실제 production 전환 전까지 변경하지 않습니다.
# sqlite          : 기존 SQLite가 primary
# postgres-shadow : PostgreSQL migration/validation용. 실제 요청은 SQLite가 primary
# postgres        : PostgreSQL가 runtime primary. DATABASE_URL 필수
# postgres로 바꾸기 전에 docs/08_POSTGRES_CUTOVER_RUNBOOK.md의 export/import/semantic validation을 반드시 완료합니다.
STORAGE_DRIVER=sqlite

# SQLite DB 파일 경로(선택). 기본 data/app.db.
DB_PATH=

# PostgreSQL migration/runtime target.
# 실제 DB를 만든 뒤 호스트 secret 환경변수에만 저장하고 저장소에는 절대 커밋하지 않습니다.
DATABASE_URL=
PG_POOL_MAX=5
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000

# 장기 사용자 데이터 보관을 강제할 운영 환경에서만 1.
# PostgreSQL primary이면 DATABASE_URL + PERSISTENT_STORAGE=1, SQLite이면 durable DB_PATH + PERSISTENT_STORAGE=1을 요구합니다.
REQUIRE_PERSISTENT_DB=0

# 실제 restart/redeploy 데이터 유지 검증을 끝낸 뒤에만 1로 설정합니다.
PERSISTENT_STORAGE=0

# ===== Business / Pro SaaS runtime =====
# 기본 OFF. 1로 켜려면 STORAGE_DRIVER=postgres + DATABASE_URL + SAAS_SESSION_SECRET가 모두 필요합니다.
# 현재 production은 0을 유지합니다.
SAAS_ENABLED=0
SAAS_SESSION_SECRET=
SAAS_SESSION_TTL_DAYS=30
SAAS_AUTH_CHALLENGE_TTL_MINUTES=15
SAAS_INVITATION_TTL_DAYS=7
SAAS_SESSION_COOKIE=insaya_saas_session

# Business Compliance Action 기한 알림 sweep. 기본 60분, 최소 60초.
# SAAS_ENABLED=0이면 scheduler는 no-op이며 DB를 조회하지 않습니다.
COMPLIANCE_NOTIFICATION_SWEEP_INTERVAL_MS=3600000

# 테스트/로컬에서만 magic-link/초대 raw token을 API 응답에 포함합니다.
# NODE_ENV=production에서는 1로 설정하면 startup/request gate가 거부합니다.
# 실제 production SaaS 활성화 전에는 별도 이메일 발송 adapter를 구현해야 합니다.
SAAS_AUTH_TOKEN_ECHO=0

# Case 개인정보 최소화 정책
CASE_TOKEN_TTL_DAYS=7
CASE_RETENTION_DAYS=30
CASE_ARCHIVED_RETENTION_DAYS=7

# 배포 도메인
SITE_URL=

# 포트
PORT=3000
