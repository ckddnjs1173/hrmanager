# ===== 노무AI 환경변수 =====
# 이 파일을 .env 로 복사해 값을 채우세요. (배포 시에는 호스트의 환경변수 설정창에 입력)

# Anthropic API 키 (https://console.anthropic.com 에서 발급)
# 비워두면 AI 상담은 '데모 모드'로 동작하고 나머지 기능은 정상 작동합니다.
ANTHROPIC_API_KEY=

# 모델 선택 (비용 민감하면 교체)
#   claude-opus-4-8    기본 · 가장 강력   ($5 / $25 per 1M)
#   claude-sonnet-4-6  균형              ($3 / $15)
#   claude-haiku-4-5   가장 저렴          ($1 / $5)
ANTHROPIC_MODEL=claude-opus-4-8

# 운영자 대시보드(/admin) 로그인 토큰. 배포 시 반드시 강력한 값으로 변경하세요.
ADMIN_TOKEN=change-this-to-a-strong-secret

# 세션 쿠키 서명 키. 비우면 ADMIN_TOKEN에서 자동 파생되지만, 별도 지정 권장.
SESSION_SECRET=

# DB 파일 경로(선택). 기본 data/app.db. 영구 디스크 마운트 시 그 경로로.
DB_PATH=

# 배포 도메인 (정적 SEO 페이지의 canonical·OG·sitemap에 사용)
# 예: https://nomu-ai.onrender.com  또는  https://내도메인.com
SITE_URL=

# 포트 (대부분의 호스트는 자동 주입하므로 비워두면 됩니다)
PORT=3000
