{
  "name": "nomu-ai",
  "version": "0.1.0",
  "private": true,
  "description": "인사야 — Case 중심 AI 노동문제 해결 서비스",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "check": "npm test && npm run build",
    "content:check": "node scripts/content-integrity-check.mjs",
    "release:check": "npm run check && npm run content:check && node scripts/release-check.mjs",
    "build": "node scripts/build-site.mjs && node scripts/write-build-info.mjs",
    "migrate": "node scripts/migrate-json-to-db.mjs",
    "ingest": "node scripts/ingest-nomusa.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore-check": "node scripts/db-restore-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "express": "^5.1.0"
  }
}
